# Local backend configuration. Copy to `.env` (gitignored) and fill real values.
# Never commit this file with secrets.
DATABASE_URL=postgresql+asyncpg://aequitas:aequitas_dev@localhost:5432/aequitas
SYNC_DATABASE_URL=postgresql://aequitas:aequitas_dev@localhost:5432/aequitas
PORT=8000

# First-party session auth (opaque tokens validated against PostgreSQL).
# No external identity provider is used.
# ALLOW_PUBLIC_REGISTRATION controls POST /v1/auth/register server-side.
# Set false in deployments that must stay closed; new users are always analyst.
# ALLOW_PUBLIC_REGISTRATION=
# SESSION_LIFETIME_HOURS=

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
SQL_MODEL=o3-mini
SYNTHESIS_MODEL=claude-3-5-sonnet-20241022
# LangGraph Postgres checkpointer (Temporal thread memory). false = in-memory only.
# USE_POSTGRES_CHECKPOINTER=true
# If true, do not fall back to MemorySaver when checkpointer init fails (stricter for CI).
# CHECKPOINTER_POSTGRES_REQUIRED=false
# Shadow analyst (APScheduler every 6h) — set false to disable
# SHADOW_ANALYST_ENABLED=true
# NEWS_API_KEY=          # e.g. newsapi.org; optional, deep research still runs RAG
# NEWS_API_URL=https://newsapi.org/v2/everything

# LangSmith observability (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aequitas-fi-production
